# ------------------------------------------------------------------
# Datenbank (SQLite lokal). Für Postgres z. B.:
# DATABASE_URL="postgresql://user:pass@host:5432/asintracker"
# ------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------
# Amazon-Daten über Keepa (https://keepa.com/#!api)
# Ohne Key läuft der Provider im MOCK-Modus mit Demo-Daten.
# ------------------------------------------------------------------
KEEPA_API_KEY=""
# Keepa-Domain: 1=com, 2=co.uk, 3=de, 4=fr, 5=co.jp, 8=it, 9=es
KEEPA_DOMAIN="3"

# ------------------------------------------------------------------
# idealo API – nutzt /api/idealo/search (+ /api/idealo/product als
# Preis-Fallback). IDEALO_API_URL = Basis-URL des Dienstes (ohne Pfad),
# z. B. http://127.0.0.1:8000 oder https://dein-idealo-dienst.example.
# Key ggf. per POST /generate_key erzeugen (localhost + SECRET_KEY).
# Ohne Konfiguration läuft der Provider im MOCK-Modus.
# ------------------------------------------------------------------
IDEALO_API_URL=""
IDEALO_API_KEY=""
# Header-Name für den API-Key (Standard: Authorization -> "Bearer <key>").
# Für RapidAPI z. B. "X-RapidAPI-Key" setzen.
IDEALO_API_KEY_HEADER="Authorization"
# Optionaler Host-Header (z. B. bei RapidAPI: "<name>.p.rapidapi.com")
IDEALO_API_HOST=""
# Ländercode für idealo-Abfragen: DE, AT, UK, FR, IT, ES
IDEALO_COUNTRY="DE"

# ------------------------------------------------------------------
# billiger.de – Affiliate/Produkt-API (Partnerzugang nötig)
# Ohne Konfiguration läuft der Provider im MOCK-Modus.
# ------------------------------------------------------------------
BILLIGER_API_URL=""
BILLIGER_API_KEY=""

# ------------------------------------------------------------------
# Margen-Standardwerte
# ------------------------------------------------------------------
# Amazon-Verkaufsprovision in Prozent (Standard 15 %)
DEFAULT_REFERRAL_FEE_PCT="15"
# Pauschale Versand-/FBA-Kosten pro Einheit in EUR
DEFAULT_FULFILLMENT_FEE_EUR="3.50"
# Ab welcher ROI-% eine Einkaufs-Chance markiert wird
BUY_OPPORTUNITY_MIN_ROI_PCT="15"
