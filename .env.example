# ------------------------------------------------------------------
# Datenbank: PostgreSQL (z. B. kostenlos via Neon / Vercel Storage).
#  - DATABASE_URL = POOLED-Verbindung (Laufzeit, serverless-tauglich)
#  - DIRECT_URL   = DIREKTE Verbindung (für `prisma db push`)
# Neon zeigt beide Strings im Dashboard an. Lokal dürfen beide gleich sein.
# ------------------------------------------------------------------
DATABASE_URL="postgresql://user:pass@host-pooler.region.aws.neon.tech/asintracker?sslmode=require"
DIRECT_URL="postgresql://user:pass@host.region.aws.neon.tech/asintracker?sslmode=require"

# ------------------------------------------------------------------
# Amazon-Daten über Keepa (https://keepa.com/#!api)
# Ohne Key läuft der Provider im MOCK-Modus mit Demo-Daten.
# ------------------------------------------------------------------
KEEPA_API_KEY=""
# Keepa-Domain: 1=com, 2=co.uk, 3=de, 4=fr, 5=co.jp, 8=it, 9=es
KEEPA_DOMAIN="3"

# ------------------------------------------------------------------
# idealo API – nutzt /api/idealo/search (+ /api/idealo/product als
# Preis-Fallback). IDEALO_API_URL = Basis-URL des Dienstes (ohne Pfad),
# z. B. http://127.0.0.1:8000 oder https://dein-idealo-dienst.example.
# Key ggf. per POST /generate_key erzeugen (localhost + SECRET_KEY).
# Ohne Konfiguration läuft der Provider im MOCK-Modus.
# ------------------------------------------------------------------
# RapidAPI-Dienst "Idealo Data" (asynchron: Start-Suche -> Poll).
# Base-URL/Host aus dem cURL-"Code Snippet" des Endpunkts übernehmen.
IDEALO_API_URL="https://idealo-data.p.rapidapi.com"
IDEALO_API_KEY=""
IDEALO_API_KEY_HEADER="x-rapidapi-key"
IDEALO_API_HOST="idealo-data.p.rapidapi.com"
# Ländercode: DE, AT, UK, FR, IT, ES
IDEALO_COUNTRY="DE"
# Endpunkt-Pfade (nur setzen, falls sie vom Standard abweichen –
# gegen das cURL-Code-Snippet in RapidAPI prüfen):
# IDEALO_PATH_GTIN="/search/gtin"
# IDEALO_PATH_TERM="/search/term"
# IDEALO_PATH_POLL="/search/results"

# ------------------------------------------------------------------
# billiger.de – Affiliate/Produkt-API (Partnerzugang nötig)
# Ohne Konfiguration läuft der Provider im MOCK-Modus.
# ------------------------------------------------------------------
BILLIGER_API_URL=""
BILLIGER_API_KEY=""

# ------------------------------------------------------------------
# Margen-Standardwerte
# ------------------------------------------------------------------
# Amazon-Verkaufsprovision in Prozent (Standard 15 %)
DEFAULT_REFERRAL_FEE_PCT="15"
# Pauschale Versand-/FBA-Kosten pro Einheit in EUR
DEFAULT_FULFILLMENT_FEE_EUR="3.50"
# Ab welcher ROI-% eine Einkaufs-Chance markiert wird
BUY_OPPORTUNITY_MIN_ROI_PCT="15"
