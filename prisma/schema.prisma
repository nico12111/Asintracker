// Prisma schema for AsinTracker
// SQLite by default; switch `provider` to "postgresql" and update DATABASE_URL for production.

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; rhel-openssl-3.0.x for Vercel's serverless runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (used at runtime on serverless).
  url       = env("DATABASE_URL")
  // Direct connection (used by `prisma db push` / migrations).
  directUrl = env("DIRECT_URL")
}

/// A tracked Amazon product identified by its ASIN.
model Product {
  id        String   @id @default(cuid())
  asin      String   @unique
  title     String?
  brand     String?
  category  String?
  imageUrl  String?
  ean       String? // GTIN/EAN, used to match products on idealo / billiger

  /// Amazon Best Sellers Rank (BSR) in the product's main category.
  salesRank Int?

  /// User-provided GTIN/EAN override, used first when matching on idealo.
  manualEan String?

  /// Current Amazon price on other EU marketplaces (cents) for A2A flips.
  amazonEsCents Int?
  amazonFrCents Int?
  amazonItCents Int?
  euPricesAt    DateTime?

  /// Current Amazon Buy-Box / sell price in cents (EUR). null = unknown.
  amazonPriceCents Int?
  /// 30-day / 90-day average Amazon Buy-Box/sell price in cents.
  amazonAvg30Cents Int?
  amazonAvg90Cents Int?
  /// Number of BSR drops in the last 30 / 90 days (sales-velocity proxy).
  salesRankDrops30 Int?
  salesRankDrops90 Int?
  /// Star rating (0–5, stored *10 not applied — plain float) and review count.
  rating        Float?
  reviewCount   Int?
  /// Number of current new offers.
  offerCountNew Int?

  /// Amazon referral fee percentage for this product (e.g. 15.0).
  referralFeePct   Float?
  /// Flat fulfilment / shipping cost per unit in cents.
  fulfillmentFeeCents Int?

  lastRefreshedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  offers     Offer[]
  shopOffers ShopOffer[]
  snapshots  PriceSnapshot[]

  @@index([asin])
}

/// Cheapest offer found at a specific online shop via the scraping provider.
model ShopOffer {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  shopKey    String
  shopName   String
  priceCents Int
  url        String?

  capturedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([productId, shopKey])
  @@index([shopKey])
}

/// The current best offer from a comparison source (one row per source per product).
model Offer {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  /// "idealo" | "billiger" | ... (see PriceSource in code)
  source     String
  priceCents Int
  url        String?
  inStock    Boolean  @default(true)
  matchedName String?
  /// Source-specific product id (e.g. idealo item id) for faster re-checks.
  externalId String?

  capturedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([productId, source])
  @@index([source])
}

/// Historical price points for trend analysis and "cheaper than before" alerts.
model PriceSnapshot {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  source     String // "amazon" | "idealo" | "billiger"
  priceCents Int
  capturedAt DateTime @default(now())

  @@index([productId, source, capturedAt])
}
